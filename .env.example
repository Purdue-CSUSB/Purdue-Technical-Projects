# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=purdue_technical_projects

# --- Login tokens -------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_hex_string
JWT_TTL=2h

# --- AI moderation of submissions -------------------------------------------
GROQ_API_KEY=gsk_replace_with_your_own_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
# The one model that reviews submissions on both boards - the showcase write-up together with
# its attached image, and the open board's text-only listings. Must be a VISION model (a
# text-only one rejects anything carrying an image with "messages[0].content must be a string")
# that accepts Groq's `reasoning_effort` parameter, which every call sets to `none` so the model
# answers with its verdict instead of burning the whole budget inside a <think> block. The
# default below is on Groq's free tier.
GROQ_MODEL=qwen/qwen3.6-27b

# --- Outbound email -----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Purdue Technical Projects <no-reply@yourdomain.com>"

# --- Where the site is served from -------------------------------------------
SITE_URL=http://localhost:3000
