{
  "name": "purdue-technical-projects",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "api": "vercel dev",
    "build": "npm run build --workspace frontend",
    "check-db": "node --env-file-if-exists=.env backend/scripts/checkDatabase.js",
    "seed": "node --env-file-if-exists=.env backend/scripts/seed.js",
    "keepalive": "node --env-file-if-exists=.env backend/scripts/keepDatabaseAwake.js",
    "ensure-indexes": "node --env-file-if-exists=.env backend/scripts/ensureIndexes.js"
  },
  "devDependencies": {
    "vercel": "^58.4.4"
  }
}
